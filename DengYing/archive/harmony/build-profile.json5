{
  "app": {
    // 签名材料不入库。空数组表示不携带任何口令与本机路径；
    // 本地构建前按 README「签名配置」在本机生成，恢复后再把 products[0].signingConfig 填回 "default"。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.5(17)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          // compose.har 是 byteCodeHar（社区 CMP 渲染层），hvigor 要求工程开启规范化 OHM URL。
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
