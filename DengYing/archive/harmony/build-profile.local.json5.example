// 本地签名模板（不入库，不含任何真实口令或本机路径）。
//
// 推荐流程：打开 DevEco Studio → Project Structure → Signing Configs，
// 勾选 Automatically generate signature（或导入自己的证书），由 IDE 在本地生成
// 签名配置；生成结果只写进本机 build-profile.json5，不要提交。
//
// 手工恢复时：复制本文件为 build-profile.local.json5（已被 .gitignore 忽略），
// 填入真实值，再把 signingConfigs 与 products[0].signingConfig 合并回
// build-profile.json5。真实 p12 / p7b / cer 也放在本机且不要提交。
//
// 注意：仓库历史中曾提交过签名口令与证书路径，这些材料应视为已泄漏；
// 请自行在 AppGallery Connect 轮换证书与口令后再使用。
{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "<STORE_FILE_PATH>",
          "storePassword": "<STORE_PASSWORD>",
          "keyAlias": "<KEY_ALIAS>",
          "keyPassword": "<KEY_PASSWORD>",
          "signAlg": "SHA256withECDSA",
          "profile": "<PROFILE_P7B_PATH>",
          "certpath": "<CERT_CER_PATH>"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default"
      }
    ]
  }
}
